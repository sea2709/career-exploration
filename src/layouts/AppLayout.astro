---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

const links = [
	{ href: '/', label: 'Introduction' },
	{ href: '/explore', label: 'Career Explorer' },
	{ href: '/interview', label: 'Mock Interview' },
	{ href: '/quiz', label: 'Interest Quiz' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0f172a" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>

	<body class="flex h-dvh flex-col bg-white">
		<nav class="border-b border-slate-200">
			<div class="mx-auto flex max-w-3xl gap-1 px-4 py-2 text-sm">
				{
					links.map(({ href, label }) => (
						<a
							href={href}
							aria-current={current === href ? 'page' : undefined}
							class="rounded-lg px-3 py-1.5 text-slate-600 hover:bg-slate-100 aria-[current=page]:bg-slate-900 aria-[current=page]:text-white"
						>
							{label}
						</a>
					))
				}
			</div>
		</nav>
		<main class="min-h-0 flex-1">
			<slot />
		</main>
	</body>
</html>
