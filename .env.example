# Sanity (Careers Exploration — rhq335ze / production)
# PUBLIC_SANITY_PROJECT_ID=rhq335ze
# PUBLIC_SANITY_DATASET=production

# Career agent service (agent/ workspace). Called server-side from /api/chat; never exposed to the browser.
# AGENT_URL=http://localhost:8787
# Must match AGENT_API_TOKEN in agent/.env
AGENT_API_TOKEN=

# Cloudflare Turnstile human check gating /api/chat.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile (add your domains + localhost).
# For local dev, Cloudflare's always-pass test keys work: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Never deploy the test keys: they accept every request.
PUBLIC_TURNSTILE_SITE_KEY=
# Also signs the human-session cookie, so rotating it signs everyone out of their session.
TURNSTILE_SECRET_KEY=
